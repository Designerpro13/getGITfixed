{
  "name": "kiro-pr-bot",
  "version": "1.0.0",
  "description": "Bot that reads a GitHub issue, generates a Kiro spec, implements the fix, and opens a PR — all from a single CLI command.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spec-gen": "tsx src/spec-gen.ts",
    "verify-mcp": "tsx src/verify-mcp.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "20.17.9",
    "eslint": "9.39.5",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.9",
    "tsx": "4.19.2"
  },
  "dependencies": {
    "@octokit/rest": "21.0.2"
  }
}
